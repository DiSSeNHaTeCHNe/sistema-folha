# Faz o Lombok anotar métodos gerados (equals/hashCode/getters/setters/toString/builders)
# com @lombok.Generated, que o JaCoCo e o SonarQube reconhecem e excluem automaticamente
# da medição de cobertura. Ver AD-014 (feature cobertura-testes-95).
lombok.addLombokGeneratedAnnotation = true
config.stopBubbling = true
