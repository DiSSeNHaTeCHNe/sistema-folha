# Copie para .sonar.env (gitignored) e preencha:
#   cp .sonar.env.example .sonar.env
#
# SonarQube compartilhado na máquina (não sobe com este repo):
#   cd ~/devtools/sonarqube && docker compose up -d
#   UI: http://localhost:9000

SONAR_HOST_URL=http://localhost:9000
SONAR_PROJECT_KEY=sistema-folha
SONAR_PROJECT_NAME=Sistema Folha

# User token do SonarQube (My Account → Security → Generate Tokens)
# Use user token (não project/global token) para o MCP.
SONAR_TOKEN=

# Apenas para o script de bootstrap (criar projeto + token):
# SONAR_USER=admin
# SONAR_PASSWORD=
